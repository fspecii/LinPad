// System-wide fastfetch config (XDG_CONFIG_DIRS), installed with ishwl.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/ish/logo.txt",
        "color": { "1": "cyan", "2": "blue" }
    },
    "modules": [
        "title",
        "separator",
        "os",
        { "type": "command", "key": "Host", "text": "ish-device-info host" },
        "kernel",
        "uptime",
        "packages",
        "shell",
        "terminal",
        { "type": "command", "key": "CPU", "text": "ish-device-info cpu" },
        { "type": "command", "key": "GPU", "text": "ish-device-info gpu" },
        "memory",
        "disk",
        "break",
        "colors"
    ]
}
