#!/bin/sh
# "Install Visual Studio Code" from the launcher: runs the VS Code installer
# (/usr/local/share/devtools/install-vscode.sh, which downloads Microsoft's build from
# code.visualstudio.com on this device) in a terminal window, so its progress is visible.
#   ish-install-vscode            open a terminal window and install there
#   ish-install-vscode --no-wait  install in the current terminal, no "press Enter" prompt
installer=/usr/local/share/devtools/install-vscode.sh

if [ "${1:-}" != --no-wait ] && [ "${1:-}" != --here ]; then
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v ish-terminal >/dev/null; then
        exec ish-terminal --title "Install Visual Studio Code" ish-install-vscode --here
    fi
fi

if [ -x /usr/local/bin/code ] && [ -x /opt/vscode/code ]; then
    echo "Visual Studio Code is already installed. Run 'code' or use the launcher."
else
    echo "Installing Visual Studio Code (Microsoft's official linux-arm64 build)."
    echo "About 250 MB is downloaded; this takes several minutes."
    echo
    if sh "$installer"; then
        rm -f /usr/share/applications/ish-install-vscode.desktop
        # The installer adds vscode.png to /usr/share/pixmaps; cache it for every style
        # that already has a cache, the active one last.
        if command -v ish-apply-style >/dev/null; then
            echo "Updating the desktop icons…"
            ish-apply-style --cache-only >/dev/null 2>&1
        fi
        echo
        echo "Done. Visual Studio Code is in the launcher (Development), or run 'code'."
    else
        echo
        echo "The installation failed; see the messages above. Run 'ish-install-vscode' to retry."
        [ "${1:-}" = --here ] && { echo "Press Enter to close."; read -r _; }
        exit 1
    fi
fi
[ "${1:-}" = --here ] && { echo "Press Enter to close."; read -r _; }
exit 0
