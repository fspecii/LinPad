+         strcpy(new_exts[advertised_count].extensionName,
+                VK_EXT_EXTERNAL_MEMORY_DMA_BUF_EXTENSION_NAME);
+         new_exts[advertised_count].specVersion = 1;
+         advertised_count++;
+      }
+   }
+#endif
