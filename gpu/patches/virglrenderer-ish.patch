+#ifdef __APPLE__
+   /* Guest zink only accepts a DRM screen when venus exposes
+    * VK_KHR_external_memory_fd, which venus derives from the renderer's
+    * VK_EXT_external_memory_dma_buf. Nothing is exported as a dma-buf on
+    * this platform; host-visible blobs stay shm-backed.
+    */
+   if (vkr_zink_compat() && physical_dev->EXT_external_memory_metal &&
+       !physical_dev->EXT_external_memory_dma_buf) {
