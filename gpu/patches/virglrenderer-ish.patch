--- a/src/venus/vkr_common.h
+++ b/src/venus/vkr_common.h
@@ -369,4 +369,18 @@ vkr_seqno_ge(uint32_t a, uint32_t b)
    return (a - b) <= INT32_MAX;
 }
 
+#ifdef __APPLE__
+/* Opt-in (VKR_ZINK_COMPAT=1) workarounds that let guest zink run on
+ * MoltenVK: advertise robustness2.nullDescriptor and
+ * VK_EXT_external_memory_dma_buf to the guest, and strip both again before
+ * they reach MoltenVK.
+ */
+static inline bool
+vkr_zink_compat(void)
+{
+   const char *env = getenv("VKR_ZINK_COMPAT");
+   return env && env[0] == '1';
+}
+#endif
+
 #endif /* VKR_COMMON_H */
