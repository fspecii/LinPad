  */
 
 #include "anon_file.h"
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#include <limits.h>
+#endif
 
 #include <errno.h>
 #include <fcntl.h>
@@ -147,6 +151,20 @@ os_create_anonymous_file(off_t size, const char *debug_name)
      if (errno != EEXIST)
        break;
    }
+#if defined(TARGET_OS_IPHONE) && TARGET_OS_IPHONE
+   /* The iOS sandbox may refuse POSIX shm; an unlinked file in the app's
+    * temporary directory is mappable and shareable the same way. */
+   if (fd < 0) {
+      const char *dir = getenv("TMPDIR");
+      char path[PATH_MAX];
+      snprintf(path, sizeof(path), "%s/%s-XXXXXX", dir && dir[0] ? dir : "/tmp", tag);
+      fd = mkstemp(path);
+      if (fd >= 0) {
+         fcntl(fd, F_SETFD, FD_CLOEXEC);
+         unlink(path);
+      }
+   }
+#endif
 #elif defined(__OpenBSD__)
    char template[] = "/tmp/mesa-XXXXXXXXXX";
    fd = shm_mkstemp(template);
diff --git a/src/venus/vkr_common.h b/src/venus/vkr_common.h
