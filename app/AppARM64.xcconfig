#include "App.xcconfig"
#include "GuestARM64.xcconfig"
#include "VirtGPU.xcconfig"

// Differentiate the ARM64 app from the x86 app
PRODUCT_NAME = iSH ARM64
// Branding only: the bundle id, app group and the "iSH ARM64.app" file name stay, so an
// update installs over the existing app and keeps its Linux system.
APP_DISPLAY_NAME = Linux for iPad
PRODUCT_BUNDLE_IDENTIFIER = $(ROOT_BUNDLE_IDENTIFIER).arm64
PRODUCT_APP_GROUP_IDENTIFIER = group.$(ROOT_BUNDLE_IDENTIFIER).arm64

// Link meson-built libraries directly from the arm64 meson build dir.
// These are NOT in the Frameworks build phase to prevent Xcode from
// auto-discovering implicit dependencies on the x86 library targets.
OTHER_LDFLAGS = $(inherited) $(MESON_BUILD_DIR)/libish.a $(MESON_BUILD_DIR)/libish_emu.a $(MESON_BUILD_DIR)/libfakefs.a $(ISH_VIRTGPU_LDFLAGS)

// Header search paths needed for sources compiled directly in this target
// (previously compiled in libiSHApp, which used AppLib.xcconfig)
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT) $(SRCROOT)/deps/libarchive/libarchive

// Swift for the native desktop (app/Desktop, DesktopKit package)
SWIFT_VERSION = 5.0
SWIFT_OBJC_BRIDGING_HEADER = app/iSH-ARM64-Bridging-Header.h

// LinPad releases are versioned independently of upstream iSH (release/RELEASING.md).
MARKETING_VERSION = 1.4.0
